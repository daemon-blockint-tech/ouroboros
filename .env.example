# Copy to .env for `docker compose`. Do NOT commit the real .env.
#
# Host tree to inventory (bind-mounted read-only at /scan/home).
SCAN_ROOT=./

# Stamped into the image and emitted records.
OUROBOROS_VERSION=dev

# Optional HTTP sink credentials (only used if you enable the sink flags in the
# compose command). The flag --http-token-env names the variable to read.
# OUROBOROS_TOKEN=replace-me
# OUROBOROS_DEVICE_ID=replace-me
